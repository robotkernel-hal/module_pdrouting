# vim: tabstop=2 softtabstop=2 shiftwidth=2 expandtab:

loglevel: [ 
  error, warning, info, 
  module_error, module_warning, module_info, 
  interface_error, interface_warning, interface_info 
  ]

modules:
- name: my_lntopics
  module_file: libmodule_lntopics.so    
  config: 
    publisher:
      - modname: my_pd_source   # module with process data source
        slave_id: 63            # slave id in module
        pd_offest: 32           # byte offset inside process data
        topic_len: 10           # length for topic
  power_up: true

