# Configuration file for module_pdrouting using robotkernel class/instance templates.
#
# This file demonstrates how to use the classes/instances pattern to avoid
# repetition when configuring many similar muxers, demuxers, or one-to-many
# broadcast entries.
#
# vi: set ft=yaml nowrap:
# -*- mode: yaml -*-

#########################################################
# Logging settings
#
# Standard robotkernel module local loglevel.
# Valid values: critical, error, warning, info, verbose, debug
#loglevel: verbose

#########################################################
# Process data demuxer configuration.
#
# Demuxing splits one input process data device into multiple
# output process data devices at byte boundaries.
#
# Per-demuxer options (see pdrouting.rkc for full option list):
#   name              (string, required)  Demuxer name.
#   pd_input_device   (string, required)  Source PD device to split.
#   zero_copy         (bool, default: false)
#                     Use pointer_buffer for zero-copy output PDs.
#   trigger           (map, optional)     Explicit trigger config.
#   trigger_name      (string, deprecated) Legacy trigger device name.
#   outputs           (list, required)    Output definitions.
#     name            (string, required)  Output infix name.
#     len             (int, required)     Byte count for this output.
#     desc            (string, optional)  Explicit PD type definition YAML.
demux:
  classes:
    datagen_outputs:
      name: $name
      pd_input_device: $pdin
      #zero_copy: false
      outputs:
      - name: axis
        len: 16

  instances:
  - { use_class: datagen_outputs, name: datagen_demux_0, pdin: datagen.slave_0.inputs.pd }
  - { use_class: datagen_outputs, name: datagen_demux_1, pdin: datagen.slave_1.inputs.pd }
  - { use_class: datagen_outputs, name: datagen_demux_2, pdin: datagen.slave_2.inputs.pd }
  - { use_class: datagen_outputs, name: datagen_demux_3, pdin: datagen.slave_3.inputs.pd }
  - { use_class: datagen_outputs, name: datagen_demux_4, pdin: datagen.slave_4.inputs.pd }
  - { use_class: datagen_outputs, name: datagen_demux_5, pdin: datagen.slave_5.inputs.pd }
  - { use_class: datagen_outputs, name: datagen_demux_6, pdin: datagen.slave_6.inputs.pd }

#########################################################
# Process data muxer configuration.
#
# Muxing combines multiple input process data devices into a single
# output process data device by serializing them consecutively.
#
# Per-muxer options (see pdrouting.rkc for full option list):
#   name              (string, required)  Muxer name.
#   pd_output_device  (string, required)  Target PD device to write to.
#   expected_rate     (int, default: 1)   Expected trigger rate in Hz.
#   zero_copy         (bool, default: false)
#                     Use pointer_buffer for zero-copy input PDs.
#   trigger           (map, optional)     Explicit trigger config.
#   trigger_name      (string, deprecated) Legacy trigger device name.
#   inputs            (list, required)    Input definitions.
#     name            (string, required)  Input infix name.
#     len             (int, required)     Byte count this input contributes.
#     desc            (string, optional)  Explicit PD type definition YAML.
mux:
  classes:
    datagen_inputs:
      name: $name
      pd_output_device: $pdout
      #expected_rate: 1000
      #zero_copy: false
      inputs:
      - name: axis
        len: 24

  instances:
  - { use_class: datagen_inputs, name: datagen_mux_0, pdout: datagen.slave_0.outputs.pd }
  - { use_class: datagen_inputs, name: datagen_mux_1, pdout: datagen.slave_1.outputs.pd }
  - { use_class: datagen_inputs, name: datagen_mux_2, pdout: datagen.slave_2.outputs.pd }
  - { use_class: datagen_inputs, name: datagen_mux_3, pdout: datagen.slave_3.outputs.pd }
  - { use_class: datagen_inputs, name: datagen_mux_4, pdout: datagen.slave_4.outputs.pd }
  - { use_class: datagen_inputs, name: datagen_mux_5, pdout: datagen.slave_5.outputs.pd }
  - { use_class: datagen_inputs, name: datagen_mux_6, pdout: datagen.slave_6.outputs.pd }

#########################################################
# Process data one-to-many (broadcast) configuration.
#
# One-to-many distributes the entire contents of one input PD device
# to multiple output PD devices unchanged.  All output PDs must have
# the same length as the input PD.
#
# Per one-to-many options:
#   name              (string, optional)  Name used in log messages.
#   pd_input_device   (string, required)  Source PD device to broadcast.
#   pd_output_devices (list, required)    List of target PD device names.
one_to_many:
  classes:
    broadcast:
      name: $name
      pd_input_device: $pdin
      pd_output_devices: $pdouts

  instances:
  - { use_class: broadcast, name: master_to_slaves,
      pdin: ecat.master.inputs.pd,
      pdouts: [ ecat.slave_0.outputs.pd, ecat.slave_1.outputs.pd, ecat.slave_2.outputs.pd ] }
